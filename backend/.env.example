# Copy to backend/.env and fill in.

# Supabase -> Project Settings -> API Keys / Data API
SUPABASE_URL=https://your-project-ref.supabase.co
# The *secret* key (sb_secret_...) or the legacy service_role key. Never put this in the frontend.
SUPABASE_SECRET_KEY=

# Signs the login cookie. Optional locally, required in production (Vercel).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
